# Copie ce fichier en .env pour tester en local dans VS Code.
# Sur GitHub, mets ces valeurs dans Settings > Secrets and variables > Actions > New repository secret.
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_USER=ton_email@yahoo.fr
SMTP_PASSWORD=mot_de_passe_application_yahoo
EMAIL_FROM=ton_email@yahoo.fr
EMAIL_TO=papalassane2003@yahoo.fr
# Optionnel : si tu veux récupérer des résultats Google réels via SerpApi.
# Sans cette clé, le mail contient des liens de recherche prêts à cliquer.
SERPAPI_API_KEY=
MAX_RESULTS_PER_QUERY=5
DRY_RUN=false
